msgid "label_require_reviewer_on_worksheet_submit"
msgstr "Require reviewer before worksheet submit"

msgid "help_require_reviewer_on_worksheet_submit"
msgstr "When disabled, worksheets can be submitted without an assigned reviewer."

msgid "label_require_reviewer_on_analysis_submit"
msgstr "Require reviewer before analysis submit"

msgid "help_require_reviewer_on_analysis_submit"
msgstr "When disabled, analyses in the worksheet can still be submitted even if no reviewer is assigned to the worksheet."

msgid "label_restrict_verify_to_assigned_reviewer"
msgstr "Restrict verification to the assigned reviewer"

msgid "help_restrict_verify_to_assigned_reviewer"
msgstr "When disabled, the add-on no longer checks whether the current user is the assigned reviewer. Verification still follows SENAITE's own permission, self-verification and dependency rules."

msgid "label_exclude_submitter_from_reviewers"
msgstr "Exclude the future submitter from reviewer options"

msgid "help_exclude_submitter_from_reviewers"
msgstr "Follows SENAITE's self-verification setting. When self-verification is not allowed, the worksheet analyst is removed from the reviewer dropdown so the submission does not fail later during verification."

msgid "prerequisite_allow_to_submit_not_assigned_disabled"
msgstr "The site has disabled \"Allow to submit unassigned analyses\", so reviewer rules cover the submission path."

msgid "prerequisite_allow_to_submit_not_assigned_enabled"
msgstr "The site has enabled \"Allow to submit unassigned analyses\". Analyses can be submitted without creating a worksheet, while reviewer rules only cover analyses inside worksheets, so this add-on can be bypassed completely. Please disable the option in Setup > Analyses."

msgid "review_queue_title"
msgstr "Review Worksheets"

msgid "review_queue_description"
msgstr "Shows only worksheets assigned to the current reviewer and waiting for verification."

