<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      metal:use-macro="here/main_template/macros/master"
      i18n:domain="maitux.stability">

  <metal:content-title fill-slot="content-title">
    <h1 class="documentFirstHeading" i18n:translate="">Sample Placement</h1>
  </metal:content-title>

  <metal:content-core fill-slot="content-core">
    <form method="POST" class="form-horizontal">
      <input tal:replace="structure context/@@authenticator/authenticator"/>

      <p class="help-block" i18n:translate="">
        Selected pending tasks are listed below. Choose a Stock Batch for each task and save.
      </p>

      <!-- 阶段 6a 冻结（2026-09-30 补齐界面层）：勾选的行里混了
           **已暂停 / 已终止** 的方案时，那些行已经被摘出去了（见
           SamplePlacementView.get_tasks_data），这里把话说清楚 ——
           否则用户会以为"少了几行"是页面出错。 -->
      <div class="alert alert-warning stability-placement-frozen-note"
           tal:condition="python:view.has_frozen_plans()">
        <span tal:content="view/frozen_message">frozen</span>
      </div>

      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th i18n:translate="">Plan</th>
            <th i18n:translate="">Task</th>
            <th i18n:translate="">Timepoint (Months)</th>
            <th i18n:translate="">Window (Days)</th>
            <th i18n:translate="">Stock Batch</th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="row view/tasks">
            <td>
              <a tal:attributes="href row/plan_url"
                 tal:content="row/plan_title">Plan</a>
            </td>
            <td>
              <span tal:content="row/task_title">Task</span>
              <input type="hidden" name="row_ids:list" tal:attributes="value row/row_id"/>
            </td>
            <td tal:content="row/timepoint_months">0</td>
            <td tal:content="row/window_days">0</td>
            <td>
              <select name="stock_batch_uid:list" class="form-control" required="required">
                <option value="" i18n:translate="">Select a Stock Batch...</option>
                <option tal:repeat="batch view/stock_batches"
                        tal:attributes="value batch/uid;
                                        selected python:view.get_selected_stock_batch_uid_for(row, repeat['row'].number() - 1) == batch.get('uid') and 'selected' or None"
                        tal:content="batch/title">
                  Batch
                </option>
              </select>
            </td>
          </tr>
          <tr tal:condition="python:not view.tasks">
            <td colspan="5" i18n:translate="">No pending tasks selected.</td>
          </tr>
        </tbody>
      </table>

      <div class="form-controls">
        <!-- 一行可放置的都没有（全被摘掉 / 没有待放置的行）时不给保存按钮：
             点了只会得到一句"没有待放置的任务"。 -->
        <button type="submit"
                class="btn btn-primary btn-sm"
                name="button_save"
                value="Save"
                tal:condition="python:bool(view.tasks)"
                i18n:translate="">Save</button>
        <button type="submit"
                class="btn btn-secondary btn-sm"
                name="button_cancel"
                value="Cancel"
                i18n:translate="">Cancel</button>
      </div>
    </form>
  </metal:content-core>
</html>
