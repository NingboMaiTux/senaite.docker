msgstr "请先选择一个已有样品。"







msgid "Linked sample for {0} plan detail row(s)."
msgstr "已为 {0} 条方案明细关联样品。"

msgid "Failed to update Stability Plan details."
msgstr "更新稳定性方案明细失败。"

msgid "Updated {0} timepoint(s) to Placed."
msgstr "已把 {0} 个时间点更新为「已放置」。"

