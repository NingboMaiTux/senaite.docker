msgid "StabilityPlans content type is not installed. Please reinstall/upgrade the maitux.stability add-on."
msgstr "未安装 StabilityPlans 内容类型，请重新安装或升级 maitux.stability 插件。"

msgid "Current template article: {0}. Leave this field empty to keep the template file."
msgstr "方案模板的附件：{0}。留空则沿用模板附件。"

msgid "No template article was found. You can upload a file here if needed."
msgstr "方案模板没有附件，如有需要可在此上传。"

