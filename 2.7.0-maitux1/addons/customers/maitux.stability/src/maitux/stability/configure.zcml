<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="maitux.stability">

  <!-- 中文注释：注册 locales 目录，否则本 addon 的 .po/.mo 不会被 zope.i18n 加载，
       模板里的 i18n:translate 与运行时翻译都会退回英文 msgid（中文站显示英文）。
       中英双语就是靠这里的目录 + i18n.py 的运行时翻译实现的。 -->
  <i18n:registerTranslations directory="locales" />

  <permission
      id="maitux.stability.permissions.AddStabilityPlanTemplate"
      title="maitux.stability: Add Stability Plan Template"
      />

  <include package=".browser" />
  <include package=".content" />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="maitux.stability"
      />

  <adapter
      factory="maitux.stability.content.stabilitystudytemplates.StabilityPlanTemplatesConstrainTypes"
      for="maitux.stability.interfaces.IStabilityPlanTemplates"
      provides="Products.CMFPlone.interfaces.constrains.ISelectableConstrainTypes"
      />

  <adapter
      factory="maitux.stability.content.stabilitystudytemplates.StabilityPlanTemplatesConstrainTypes"
      for="maitux.stability.interfaces.IStabilityPlanTemplates"
      provides="Products.CMFPlone.interfaces.constrains.IConstrainTypes"
      />

  <adapter
      name="workflow_action_create_plan"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stability.browser.view.WorkflowActionCreatePlanAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <!-- 稳定性方案列表页「复制计划」：跳到新建表单并按被复制方案预填 -->
  <adapter
      name="workflow_action_copy_plan"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stability.browser.view.WorkflowActionCopyPlanAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <adapter
      name="workflow_action_sample_placement"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stability.browser.view.WorkflowActionSamplePlacementAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <adapter
      name="workflow_action_sync_plan_tasks"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stability.browser.view.WorkflowActionSyncPlanTasksAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <genericsetup:registerProfile
      name="default"
      title="MAITUX Stability Studies"
      directory="profiles/default"
      description="Stability Studies for MAITUX"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:importStep
      name="maitux.stability.setuphandler"
      title="maitux.stability setup handler"
      description="Install MAITUX Stability Studies registrations"
      handler="maitux.stability.setuphandlers.setup_handler">
    <depends name="plone-various"/>
  </genericsetup:importStep>

  <genericsetup:registerProfile
      name="uninstall"
      title="Uninstall MAITUX Stability Studies"
      directory="profiles/uninstall"
      description="Uninstalls the maitux.stability package"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:importStep
      name="maitux.stability.uninstallhandler"
      title="maitux.stability uninstall handler"
      description="Uninstall MAITUX Stability Studies registrations"
      handler="maitux.stability.setuphandlers.uninstall_handler">
    <depends name="plone-various"/>
  </genericsetup:importStep>

  <subscriber
      for="maitux.stability.interfaces.IStabilityPlanTemplate
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler="maitux.stability.subscribers.stability_plan_template_added"
      />

  <subscriber
      for="maitux.stability.interfaces.IStabilityPlanTemplate
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler="maitux.stability.subscribers.stability_plan_template_modified"
      />

  <subscriber
      for="maitux.stability.interfaces.IStabilityPlan
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler="maitux.stability.subscribers.stability_plan_added"
      />

  <subscriber
      for="maitux.stability.interfaces.IStabilityPlan
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler="maitux.stability.subscribers.stability_plan_modified"
      />

</configure>

