<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="maitux.setupmenu">

  <!--
    plone.toolbar 管理器覆盖：注册在本 add-on 的浏览器层上，
    与 senaite.core 的注册（layer=ISenaiteCore）layer 不同，不构成冲突；
    本层激活时（安装后）按更具体的 layer 优先命中。
  -->
  <browser:viewletManager
      name="plone.toolbar"
      provides="plone.app.layout.viewlets.interfaces.IToolbar"
      permission="zope2.View"
      class=".toolbar.ToolbarViewletManager"
      layer="maitux.setupmenu.interfaces.IMaituxSetupMenuLayer"
      />

  <!--
    用户端 Setup 界面：所有登录用户可访问（zope2.View），
    菜单按当前用户角色过滤。右上角齿轮（非管理员）指向这里。
  -->
  <browser:page
      name="maitux-setup"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".setupview.SetupMenuView"
      permission="zope2.View"
      layer="maitux.setupmenu.interfaces.IMaituxSetupMenuLayer"
      />

  <!--
    管理界面：仅管理员（senaite.core: Manage Bika），
    表格配置每个菜单的启用状态与允许角色。
    入口：Site Setup → Menu Management。
  -->
  <browser:page
      name="maitux-setupmenu"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".menumanagement.SetupMenuManagementView"
      permission="senaite.core.permissions.ManageBika"
      layer="maitux.setupmenu.interfaces.IMaituxSetupMenuLayer"
      />

</configure>
