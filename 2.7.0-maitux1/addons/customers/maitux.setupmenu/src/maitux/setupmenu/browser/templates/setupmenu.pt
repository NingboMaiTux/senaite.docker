<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      metal:use-macro="here/main_template/macros/master"
      i18n:domain="maitux.setupmenu">

  <metal:block fill-slot="senaite_legacy_js"
               tal:define="portal context/@@plone_portal_state/portal;">
    <script type="text/javascript"
            src="senaite.core.setupview.js"
            tal:attributes="src string:${portal/absolute_url}/++plone++senaite.core.static/js/senaite.core.setupview.js"></script>
    <script type="text/javascript">
      window.addEventListener("DOMContentLoaded", function () {
        if (window.SetupViewController) {
          new window.SetupViewController().load();
        }
      });
    </script>
  </metal:block>

  <metal:content-title fill-slot="content-title">
    <h1 class="documentFirstHeading" i18n:translate="">Setup</h1>
  </metal:content-title>

  <metal:content-description fill-slot="content-description">
    <p class="documentDescription" i18n:translate="">
      Configuration menu entries assigned to your role.
    </p>
  </metal:content-description>

  <metal:content-core fill-slot="content-core">
    <div id="setupview" class="row"
         tal:define="items view/setupitems">

      <div class="col-sm-12 mb-4">
        <input id="searchbox"
               autofocus
               type="text"
               class="form-control form-control-lg"
               placeholder="Type to filter ..."
               i18n:attributes="placeholder"/>
      </div>

      <tal:noitems condition="python:not items">
        <div class="col-sm-12">
          <div class="alert alert-info" role="alert" i18n:translate="">
            No setup items are available for your role. Please contact your administrator.
          </div>
        </div>
      </tal:noitems>

      <tal:tiles tal:repeat="item items">
        <div class="tilewrapper col-xs-12 col-sm-6 col-md-4 col-lg-3">
          <a class="tile text-capitalized text-decoration-none"
             tal:attributes="href item/absolute_url;
                             title item/Title"
             i18n:attributes="title">
            <div class="item text-truncate">
              <img src="#"
                   class="icon"
                   tal:replace="structure python:view.get_icon_for(item, css_class='icon')"/>
              <span class="title"
                    i18n:translate=""
                    tal:content="item/Title">
                Setup Item Title
              </span>
            </div>
            <div class="small text-right"
                 tal:define="count python:view.get_count(item)"
                 tal:condition="python:count>0">
              <span class="text-secondary">
                <span tal:content="count"></span>
              </span>
              <span i18n:translate=""
                    tal:condition="python:count == 1"
                    class="text-secondary">Item</span>
              <span i18n:translate=""
                    tal:condition="python:count > 1"
                    class="text-secondary">Items</span>
            </div>
          </a>
        </div>
      </tal:tiles>
    </div>
  </metal:content-core>

</html>
