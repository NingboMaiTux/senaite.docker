msgid "Setup"
msgstr "设置"

msgid "Configuration menu entries assigned to your role."
msgstr "当前角色可用的配置菜单。"

msgid "Type to filter ..."
msgstr "输入以筛选 ..."

msgid "No setup items are available for your role. Please contact your administrator."
msgstr "当前角色没有可用的配置菜单，请联系管理员。"

msgid "Item"
msgstr "项"

msgid "Items"
msgstr "项"

msgid "Menu Management"
msgstr "菜单管理"

msgid "Enable role-based menu filtering"
msgstr "启用基于角色的菜单过滤"

msgid "When disabled, all menus are visible to everyone. When enabled, only menus enabled below and assigned to the user's roles are displayed. Menus are hidden for all non-admin users by default."
msgstr "关闭时所有菜单对所有人可见。开启时，仅显示下方已启用且已分配给当前用户角色的菜单。默认情况下，除管理员外的所有菜单均隐藏。"

msgid "Menu"
msgstr "菜单"

msgid "Source"
msgstr "来源"

msgid "Enabled"
msgstr "启用"

msgid "Allowed roles"
msgstr "允许的角色"

msgid "Legacy Setup"
msgstr "旧版设置"

msgid "Add-on"
msgstr "插件"

msgid "Other"
msgstr "其他"

msgid "Save"
msgstr "保存"

msgid "Changes saved."
msgstr "更改已保存。"
