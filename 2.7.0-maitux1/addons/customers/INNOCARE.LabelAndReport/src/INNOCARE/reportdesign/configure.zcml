<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="INNOCARE.Reportdesign">

  <include package="Products.GenericSetup" file="meta.zcml" />

  <!-- Keep worksheet print templates registered as before. -->
  <plone:static
      directory="templates/print"
      type="worksheets"
      name="reportdesign"
  />

  <!-- Register current-project report templates for senaite.impress.
       Both CoA and DataReport live in the same directory so they are
       easier to maintain together. -->
  <plone:static
      directory="templates/reports"
      type="senaite.impress.reports"
  />

</configure>
