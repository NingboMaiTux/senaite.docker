<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="maitux.worksheetfilter">

  <genericsetup:upgradeStep
      title="Register the maitux.worksheetfilter registry records"
      description="Writes the addon's registry records into the site registry."
      source="1000"
      destination="1001"
      handler="maitux.worksheetfilter.upgrades.import_registry"
      sortkey="1"
      profile="maitux.worksheetfilter:default"
      />

</configure>
