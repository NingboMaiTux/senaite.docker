<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master">

<head>
  <metal:block fill-slot="top_slot">
    <style>
      .pdf-test-panel {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 20px;
      }
      .pdf-test-log {
        background: #1e1e1e;
        color: #00ff99;
        font-family: monospace;
        height: 120px;
        overflow-y: auto;
        padding: 12px;
        border-radius: 4px;
        white-space: pre-wrap;
      }
      .pdf-test-textarea {
        min-height: 320px;
        font-family: Consolas, monospace;
      }
    </style>
  </metal:block>
</head>

<body>
  <metal:content fill-slot="main">
    <div class="documentContent">
      <h1 class="documentFirstHeading">Instrument Acquisition PDF Test</h1>
      <span tal:replace="structure context/@@authenticator/authenticator"></span>

      <div class="pdf-test-panel">
        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label>Instrument Parsing Template</label>
              <select class="form-control" id="template-uid">
                <option value="">-- Select --</option>
                <tal:items tal:repeat="t view/templates">
                  <option tal:attributes="value t/uid; selected python:request.get('uid') == t['uid'] and 'selected' or None"
                          tal:content="t/title">Template</option>
                </tal:items>
              </select>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label>PDF File</label>
              <input type="file" class="form-control" id="pdf-file" accept="application/pdf" />
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-12">
            <button class="btn btn-primary" id="btn-extract">1. Extract Text</button>
            <button class="btn btn-success" id="btn-parse" style="margin-left: 8px;">2. Parse With Script</button>
            <button class="btn btn-warning" id="btn-write" style="margin-left: 8px;">3. Write To System</button>
            <button class="btn btn-default" id="btn-clear" style="margin-left: 8px;">Clear</button>
            <label style="margin-left: 15px; font-weight: normal;">
              <input type="checkbox" id="allow-overwrite" />
              Allow overwrite (target(s) whose current value differs)
            </label>
          </div>
        </div>

        <div class="row" style="margin-top: 15px;">
          <div class="col-md-12">
            <div class="pdf-test-log" id="console-log"></div>
          </div>
        </div>
      </div>

      <div class="row" style="margin-top: 20px;">
        <div class="col-md-6">
          <h3>Extracted Text</h3>
          <textarea id="extracted-text" class="form-control pdf-test-textarea"></textarea>
        </div>
        <div class="col-md-6">
          <h3>Parsed Result</h3>
          <textarea id="parsed-text" class="form-control pdf-test-textarea"></textarea>
        </div>
      </div>
    </div>

    <script type="text/javascript">
/* <![CDATA[ */
    (function($) {
        var baseUrl = window.location.href.split('#')[0].split('?')[0].replace(/\/$/, '');
        var appUrl = baseUrl.replace(/\/@@instrument_acquisition_pdf_test$/, '');
        var extractUrl = appUrl + '/@@instrument_acquisition_pdf_extract';
        var parseUrl = appUrl + '/@@instrument_acquisition_pdf_parse';
        var writeUrl = appUrl + '/@@instrument_acquisition_pdf_write';
        var authenticator = $('input[name="_authenticator"]').first().val() || null;

        function log(msg, type) {
            var colors = { error: '#ff6666', info: '#66d9ef', success: '#00ff99' };
            var timestamp = new Date().toLocaleTimeString();
            $('<div>')
                .css('color', colors[type] || '#cccccc')
                .text('[' + timestamp + '] ' + msg)
                .appendTo('#console-log');
            $('#console-log').scrollTop($('#console-log')[0].scrollHeight);
        }

        function formatValue(value) {
            if ($.isArray(value)) {
                return '[' + value.join(', ') + ']';
            }
            if (value === null || value === undefined) {
                return '';
            }
            return String(value);
        }

        function logAvailableAnalyses(items) {
            if (!items || !items.length) {
                return;
            }
            log('Available analyses in sample:', 'info');
            $.each(items, function(_, item) {
                log(
                    'analysis_keyword=' + (item.analysis_keyword || '') +
                    ', analysis_title=' + (item.analysis_title || '') +
                    ', service_keyword=' + (item.service_keyword || '') +
                    ', service_title=' + (item.service_title || ''),
                    'info'
                );
            });
        }

        function logSampleDetails(sample) {
            if (!sample) {
                return;
            }

            log('Sample: ' + (sample.sample_id || sample.sample_name || '(unknown)') +
                ' (matched by ' + (sample.matched_by || 'unknown') + ')', 'info');

            if (sample.updated && sample.updated.length) {
                log('Updated analyses: ' + sample.updated.map(function(item) {
                    return (item.analysis_title || item.analysis_keyword || item.target_keyword || '') +
                        '=' + formatValue(item.value);
                }).join(', '), 'success');
            }

            if (sample.missing && sample.missing.length) {
                log('Missing analyses: ' + sample.missing.map(function(item) {
                    return item.analysis_keyword || item.target_keyword || item.source_result_name || '(unknown)';
                }).join(', '), 'error');
            }

            if (sample.skipped && sample.skipped.length) {
                log('Skipped items: ' + sample.skipped.map(function(item) {
                    return item.reason || 'unknown reason';
                }).join(', '), 'info');
            }

            if (sample.worksheet_attachments && sample.worksheet_attachments.length) {
                log('Worksheet attachments added: ' + sample.worksheet_attachments.map(function(item) {
                    return (item.worksheet_title || item.worksheet_uid || '(worksheet)') +
                        ' <- ' + (item.attachment_title || item.attachment_uid || '(attachment)') +
                        ' @ ' + (item.analysis_keyword || '');
                }).join(' | '), 'success');
            }

            logAvailableAnalyses(sample.available_analyses || []);
        }

        $('#btn-extract').click(function() {
            var fileInput = $('#pdf-file')[0];
            if (!fileInput.files || !fileInput.files.length) {
                alert('Please choose a PDF file');
                return;
            }

            var formData = new FormData();
            formData.append('pdf_file', fileInput.files[0]);
            if (authenticator) {
                formData.append('_authenticator', authenticator);
            }

            log('Extracting text from PDF...', 'info');
            $.ajax({
                url: extractUrl,
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(resp) {
                    if (resp.success) {
                        $('#extracted-text').val(resp.text || '');
                        log((resp.filename || 'PDF') + ': text extracted', 'success');
                    } else {
                        log(resp.message || 'PDF extraction failed', 'error');
                    }
                },
                error: function() {
                    log('PDF extraction request failed', 'error');
                }
            });
        });

        $('#btn-parse').click(function() {
            var uid = $('#template-uid').val();
            var text = $('#extracted-text').val();
            var fileInput = $('#pdf-file')[0];
            var hasFile = fileInput && fileInput.files && fileInput.files.length;
            if (!uid) {
                alert('Please select a template');
                return;
            }
            if (!text && !hasFile) {
                alert('Please extract text first');
                return;
            }

            log('Parsing with template script (.py uses coordinates, PDF attached)...', 'info');
            var formData = new FormData();
            formData.append('uid', uid);
            formData.append('text', text || '');
            if (hasFile) {
                formData.append('pdf_file', fileInput.files[0]);
            }
            if (authenticator) {
                formData.append('_authenticator', authenticator);
            }
            $.ajax({
                url: parseUrl,
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(resp) {
                    if (resp.success) {
                        $('#parsed-text').val(resp.parsed || '');
                        log('Parsed (' + (resp.script_kind || 'none') + ') with template: ' +
                            (resp.template_title || uid), 'success');
                    } else {
                        log(resp.message || 'Parse failed', 'error');
                    }
                },
                error: function() {
                    log('Parse request failed', 'error');
                }
            });
        });

        $('#btn-clear').click(function() {
            $('#console-log').empty();
            $('#extracted-text').val('');
            $('#parsed-text').val('');
            $('#pdf-file').val('');
        });

        function postParsed(parsed, confirmWrite) {
            var fileInput = $('#pdf-file')[0];
            var formData = new FormData();
            formData.append('parsed', parsed);
            if (confirmWrite) {
                formData.append('confirm', '1');
                // 现值与本次不同的目标位默认不写；勾了才允许覆盖
                if ($('#allow-overwrite').prop('checked')) {
                    formData.append('overwrite', '1');
                }
            }
            if (fileInput && fileInput.files && fileInput.files.length) {
                formData.append('pdf_file', fileInput.files[0]);
            }
            if (authenticator) {
                formData.append('_authenticator', authenticator);
            }
            return $.ajax({
                url: writeUrl,
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json'
            });
        }

        function logReportDiff(details) {
            log('WorkSheet: ' + (details.worksheet_id || '?') +
                ' (' + (details.worksheet_title || '') + ')', 'info');
            $.each(details.diff || [], function(_, row) {
                var status = String(row.status || '');
                var text = (row.analysis_keyword || '?') + '.' +
                    (row.interim_keyword || '?') +
                    '  [' + status + ']  current=' + (row.current || '(empty)') +
                    '  new=' + (row.next || '');
                if (status === 'DIFF' && row.same_ignoring_spaces) {
                    text += '   (formatting only)';
                }
                if (row.hint) {
                    text += '   hint=' + row.hint;
                }
                var type = 'info';
                if (status === 'MATCH' || status === 'WRITTEN') {
                    type = 'success';
                } else if (status.indexOf('MISSING') === 0 ||
                           status === 'WRITE_ERROR') {
                    type = 'error';
                }
                log(text, type);
            });
            $.each(details.warnings || [], function(_, item) {
                log('warn: ' + item, 'info');
            });
        }

        $('#btn-write').click(function() {
            var parsed = $('#parsed-text').val();
            if (!parsed) {
                alert('Please parse the extracted text first');
                return;
            }

            log('Writing parsed JSON into system...', 'info');
            postParsed(parsed, false).done(function(resp) {
                var details = resp.details || {};
                log('response mode=' + (details.mode || '(none)') +
                    ', success=' + resp.success, 'info');
                try {
                    runWriteBranch(parsed, resp, details);
                } catch (err) {
                    log('frontend handler error: ' + err, 'error');
                    log('details=' + JSON.stringify(details).slice(0, 1500), 'info');
                }
            }).fail(function(xhr) {
                log('Write request failed (HTTP ' + (xhr && xhr.status) +
                    ') ' + ((xhr && xhr.responseText) || '').slice(0, 300),
                    'error');
            });
        });

        function runWriteBranch(parsed, resp, details) {
            var rows = details.diff || [];
            var samples = details.samples || [];
            var rendered = false;

            // 报告形态但无法落位（缺 WorkSheet ID / 无目标位等）
            if (details.mode === 'plan') {
                log(resp.message || 'report import could not be planned', 'error');
                logReportDiff(details);
                rendered = true;
            } else if (details.mode === 'dry-run') {
                // 报告形态：第一次只 dry-run，确认后再写
                log(resp.message || 'dry-run', resp.success ? 'info' : 'error');
                logReportDiff(details);
                rendered = true;
                var skipped = details.skipped_overwrite || 0;
                if (!details.writable && !skipped) {
                    return;
                }
                var prompt = 'dry-run: ' + (details.writable || 0) +
                    ' target(s) writable';
                if (skipped) {
                    prompt += ', ' + skipped +
                        ' skipped because the current value differs' +
                        ' (tick "Allow overwrite" to include them)';
                }
                if (!window.confirm(prompt + '. Write now?')) {
                    log('Cancelled. Nothing was written.', 'info');
                    return;
                }
                log('Confirmed. Writing...', 'info');
                postParsed(parsed, true).done(function(resp2) {
                    var details2 = (resp2 && resp2.details) || {};
                    log(resp2.message || '', resp2.success ? 'success' : 'error');
                    logReportDiff(details2);
                }).fail(function(xhr) {
                    log('Write request failed (HTTP ' + (xhr && xhr.status) + ')',
                        'error');
                });
            } else {
                // 通道 A（samples 形态）或其它
                if (resp.success) {
                    log(resp.message || 'Parsed JSON written successfully', 'success');
                } else {
                    log(resp.message || 'Write to system failed', 'error');
                }
                $.each(samples, function(_, sample) {
                    logSampleDetails(sample);
                });
                rendered = !!samples.length;
            }

            // ★ 兜底：什么都没渲染出来时，直接把原始响应打出来（绝不静默）
            if (!rendered && !rows.length) {
                log('no detail rendered, raw response: ' +
                    JSON.stringify(resp).slice(0, 1500), 'error');
            }
        }
    })(jQuery);
/* ]]> */
    </script>
  </metal:content>
</body>
</html>
