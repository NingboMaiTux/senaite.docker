<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="maitux.stock">

  <!-- 中文注释：必须注册 locales 目录，否则本 addon 的 .po/.mo 永远不会被
       zope.i18n 加载，页面上所有 i18n:translate 都会退回英文 msgid。
       本仓库其它自研 addon 与 senaite.core 都有这一行，此前 maitux.stock 漏了。 -->
  <i18n:registerTranslations directory="locales" />

  <include package=".browser" />
  <include package=".content" />

  <utility
      factory=".vocabularies.SuppliersVocabularyFactory"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="maitux.stock.vocabularies.suppliers" />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="maitux.stock"
      />

  <genericsetup:registerProfile
      name="default"
      title="MAITUX Stock Management"
      directory="profiles/default"
      description="Stock Management for MAITUX"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:importStep
      name="maitux.stock.setuphandler"
      title="maitux.stock setup handler"
      description="Install MAITUX Stock site structure and registrations"
      handler="maitux.stock.setuphandlers.setup_handler">
    <depends name="plone-various"/>
    <depends name="typeinfo"/>
  </genericsetup:importStep>

  <genericsetup:registerProfile
      name="uninstall"
      title="Uninstall MAITUX Stock Management"
      directory="profiles/uninstall"
      description="Uninstalls the maitux.stock package"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:importStep
      name="maitux.stock.uninstallhandler"
      title="maitux.stock uninstall handler"
      description="Uninstall MAITUX Stock registrations"
      handler="maitux.stock.setuphandlers.uninstall_handler">
    <depends name="plone-various"/>
  </genericsetup:importStep>

  <subscriber
      for="maitux.stock.interfaces.IStockBatch
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler="maitux.stock.subscribers.stockbatch_added"
      />

  <!-- 领用申请单：新建补编号 / 迁移前记录签名并执行扣减 -->
  <subscriber
      for="maitux.stock.interfaces.IStockUsageRequest
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler="maitux.stock.subscribers.stockusagerequest_added"
      />

  <subscriber
      for="maitux.stock.interfaces.IStockUsageRequest
           Products.DCWorkflow.interfaces.IBeforeTransitionEvent"
      handler="maitux.stock.subscribers.stockusagerequest_before_transition"
      />

  <!-- 领用申请单的工作流守卫（非申请人 / 审批角色 / fail-closed 签名检查） -->
  <adapter
      factory="maitux.stock.guards.StockUsageRequestGuard"
      for="maitux.stock.interfaces.IStockUsageRequest"
      provides="bika.lims.interfaces.IGuardAdapter" />

  <adapter
      name="workflow_action_stockbatch_consume"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stock.browser.workflow.WorkflowActionStockBatchConsumeAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <adapter
      name="workflow_action_stockbatch_destroy"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stock.browser.workflow.WorkflowActionStockBatchDestroyAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <adapter
      name="workflow_action_stockbatch_return"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stock.browser.workflow.WorkflowActionStockBatchReturnAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <adapter
      name="workflow_action_stockbatch_split"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stock.browser.workflow.WorkflowActionStockBatchSplitAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <adapter
      name="workflow_action_stockbatch_stocktake"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stock.browser.workflow.WorkflowActionStockBatchStocktakeAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <adapter
      name="workflow_action_stockbatch_print"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stock.browser.workflow.WorkflowActionStockBatchPrintAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

  <!-- 审核领用申请：批次列表里点"审核领用"后跳到对应申请单 -->
  <adapter
      name="workflow_action_stockbatch_review_usage"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      factory="maitux.stock.browser.workflow.WorkflowActionStockBatchReviewUsageAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public" />

</configure>

