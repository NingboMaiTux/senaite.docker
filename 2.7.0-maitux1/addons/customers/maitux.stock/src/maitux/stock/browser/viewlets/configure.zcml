<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           i18n_domain="maitux.stock">

  <browser:viewlet
      for="maitux.stock.interfaces.IStockBatches"
      name="maitux.stock.low_quantity_viewlet"
      class="maitux.stock.browser.viewlets.lowquantity.StockBatchesLowQuantityViewlet"
      manager="plone.app.layout.viewlets.interfaces.IAboveContent"
      template="templates/stock_low_quantity_viewlet.pt"
      permission="zope2.View"
      />

  <!-- 中文注释：addon 自带的样式表（有效期提醒的行底色）由这个 viewlet 注入
       <head>。注册在 IHtmlHead 而不是批次列表视图上：批次表格可能出现在搜索、
       看板等其它页面上，只挂列表视图会漏掉。 -->
  <browser:viewlet
      for="*"
      name="maitux.stock.styling"
      class="maitux.stock.browser.viewlets.styling.StockStylingViewlet"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      template="templates/stock_styling.pt"
      permission="zope2.View"
      />

</configure>

