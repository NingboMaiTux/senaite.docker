<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      i18n:domain="maitux.stock"
      metal:use-macro="context/main_template/macros/master">

  <metal:content fill-slot="content-core">
    <tal:block tal:define="batches python:view.get_batches();
                           errors python:request.get('consume_errors', []);
                           signature_required python:view.requires_signature(batches)">
      <div class="mb-3">
        <h1 i18n:translate="" tal:condition="python:not signature_required">Consume Stock Batches</h1>
        <h1 i18n:translate="" tal:condition="signature_required">Request Stock Usage</h1>
      </div>

      <form method="post" tal:attributes="action string:${context/absolute_url}/@@stockbatch_consume">
        <input tal:replace="structure context/@@authenticator/authenticator"/>
        <input type="hidden" name="uids" tal:attributes="value python:','.join(view.get_uids())" />

        <tal:block tal:condition="python:errors">
          <div class="alert alert-danger">
            <div tal:repeat="e errors" tal:content="python:e[1]">Error</div>
          </div>
        </tal:block>

        <tal:block tal:condition="signature_required">
          <div class="alert alert-warning">
            <strong i18n:translate="">These items require an approval workflow</strong>
            <div i18n:translate="">At least one selected batch belongs to a stock item that requires approval. The stock cannot be consumed directly: submitting this form raises a usage request that goes to a reviewer. The stock is deducted only after a different person reviews and signs the request.</div>
          </div>
        </tal:block>

        <table class="table table-sm table-striped">
          <thead>
            <tr>
              <th i18n:translate="">Batch ID</th>
              <th i18n:translate="">Stock</th>
              <th class="text-right" i18n:translate="">Current Amount / Unit</th>
              <th class="text-right" i18n:translate="">Target Quantity</th>
              <th class="text-right" i18n:translate="">Quantity</th>
              <th i18n:translate="">Remarks</th>
              <th i18n:translate="">Approval</th>
            </tr>
          </thead>
          <tbody>
            <tal:block tal:condition="python:not batches">
              <tr><td colspan="7" i18n:translate="">No items selected</td></tr>
            </tal:block>
            <tal:block tal:repeat="batch batches">
              <tal:block tal:define="info python:view.get_display_info(batch);
                                     uid python:info.get('uid')">
                <tr>
                  <td tal:content="python:info.get('batch_id') or info.get('title')">-</td>
                  <td tal:content="python:info.get('stock_title')">-</td>
                  <td class="text-right">
                    <span tal:replace="python:info.get('current_amount')">-</span>
                    <span>&nbsp;</span>
                    <span tal:replace="python:info.get('unit_title')">-</span>
                  </td>
                  <td class="text-right" tal:content="python:getattr(batch, 'target_quantity', '')">-</td>
                  <td class="text-right">
                    <input type="number" step="0.01" min="0.01"
                           tal:attributes="name python:'qty.{}'.format(uid);
                                           value python:request.form.get('qty.{}'.format(uid), '')"
                           required="required"
                           class="form-control form-control-sm" />
                  </td>
                  <td>
                    <input type="text"
                           tal:attributes="name python:'remarks.{}'.format(uid);
                                           value python:request.form.get('remarks.{}'.format(uid), '')"
                           class="form-control form-control-sm" />
                  </td>
                  <td>
                    <span class="badge badge-warning"
                          i18n:translate=""
                          tal:condition="python:info.get('requires_signature')">Required</span>
                    <span class="text-muted" tal:condition="python:not info.get('requires_signature')">-</span>
                  </td>
                </tr>
              </tal:block>
            </tal:block>
          </tbody>
        </table>

        <!-- 申请模式：填写领用用途，提交后进入电子签名 -->
        <tal:block tal:condition="signature_required">
          <div class="card mb-3">
            <div class="card-header" i18n:translate="">Usage Request</div>
            <div class="card-body">
              <div class="form-group">
                <label for="usage-purpose">
                  <span i18n:translate="">Purpose</span>
                  <span class="text-danger">*</span>
                </label>
                <textarea id="usage-purpose"
                          class="form-control form-control-sm"
                          name="purpose"
                          rows="3"
                          required="required"
                          tal:content="python:view.get_posted_purpose()"></textarea>
                <small class="form-text text-muted" i18n:translate="">Why this stock is requested. The reviewer will see this text together with the requested quantities.</small>
              </div>
              <div class="alert alert-info mb-0" i18n:translate="">After submitting, the request goes to the reviewer queue as pending review. The stock is deducted only after a different person reviews and signs it.</div>
            </div>
          </div>
        </tal:block>

        <div class="mt-3">
          <a tal:attributes="href context/absolute_url"
             class="btn btn-outline-secondary" i18n:translate="">Cancel</a>
          <button type="submit" name="form.button.submit" class="btn btn-primary"
                  i18n:translate=""
                  tal:condition="signature_required">Submit Request</button>
          <button type="submit" name="form.button.submit" class="btn btn-primary"
                  i18n:translate=""
                  tal:condition="python:not signature_required">Save</button>
        </div>
      </form>
    </tal:block>
  </metal:content>
</html>
