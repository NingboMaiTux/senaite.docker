<?xml version="1.0"?>
<dc-workflow xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             workflow_id="senaite_stockusagerequest_workflow"
             title="Stock Usage Request Workflow"
             description="发起领用（申请人签名）-> 审核领用（非申请人签名）-> 自动扣减"
             state_variable="review_state"
             initial_state="draft"
             manager_bypass="False"
             i18n:domain="maitux.stock">

  <permission>View</permission>
  <permission>Access contents information</permission>
  <permission>Modify portal content</permission>
  <permission>Delete objects</permission>

  <!-- *** STATES *** -->

  <!-- 新建后几乎不停留：领用页创建完立即跳转去签名（submit） -->
  <state state_id="draft" title="Draft" i18n:attributes="title" purge="True">
    <description>Created but not yet submitted for signature</description>
    <exit-transition transition_id="submit"/>
    <exit-transition transition_id="cancel"/>

    <permission-map name="View" acquired="False">
      <permission-role>LabManager</permission-role>
      <permission-role>InventoryAdministrator</permission-role>
      <permission-role>Manager</permission-role>
      <!-- 中文注释：Owner = 创建者（CMF 自动赋予）。这样申请人能看到"自己那张"
           申请单，但看不到审批目录、也看不到别人的申请单。 -->
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Modify portal content" acquired="False">
      <permission-role>LabClerk</permission-role>
      <permission-role>LabManager</permission-role>
      <permission-role>InventoryAdministrator</permission-role>
      <permission-role>Manager</permission-role>
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map name="Delete objects" acquired="True"/>
  </state>

  <!-- 待审核：只有审核角色有 Modify，申请人（若只是 LabClerk）不能再改 -->
  <state state_id="submitted" title="Pending Review" i18n:attributes="title" purge="True">
    <description>Signed by the applicant, waiting for a different reviewer</description>
    <exit-transition transition_id="approve"/>
    <exit-transition transition_id="reject"/>
    <exit-transition transition_id="retract"/>

    <permission-map name="View" acquired="False">
      <permission-role>LabManager</permission-role>
      <permission-role>InventoryAdministrator</permission-role>
      <permission-role>Manager</permission-role>
      <!-- 中文注释：Owner = 创建者（CMF 自动赋予）。这样申请人能看到"自己那张"
           申请单，但看不到审批目录、也看不到别人的申请单。 -->
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Modify portal content" acquired="False">
      <permission-role>LabManager</permission-role>
      <permission-role>InventoryAdministrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="Delete objects" acquired="False"/>
  </state>

  <state state_id="approved" title="Approved" i18n:attributes="title" purge="True">
    <description>Approved and signed by a second person; stock already deducted</description>

    <permission-map name="View" acquired="False">
      <permission-role>LabManager</permission-role>
      <permission-role>InventoryAdministrator</permission-role>
      <permission-role>Manager</permission-role>
      <!-- 中文注释：Owner = 创建者（CMF 自动赋予）。这样申请人能看到"自己那张"
           申请单，但看不到审批目录、也看不到别人的申请单。 -->
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Modify portal content" acquired="False"/>
    <permission-map name="Delete objects" acquired="False"/>
  </state>

  <state state_id="rejected" title="Rejected" i18n:attributes="title" purge="True">
    <description>Rejected by the reviewer; no stock was deducted</description>

    <permission-map name="View" acquired="False">
      <permission-role>LabManager</permission-role>
      <permission-role>InventoryAdministrator</permission-role>
      <permission-role>Manager</permission-role>
      <!-- 中文注释：Owner = 创建者（CMF 自动赋予）。这样申请人能看到"自己那张"
           申请单，但看不到审批目录、也看不到别人的申请单。 -->
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Modify portal content" acquired="False"/>
    <permission-map name="Delete objects" acquired="False"/>
  </state>

  <state state_id="cancelled" title="Cancelled" i18n:attributes="title" purge="True">
    <description>Withdrawn by the applicant; no stock was deducted</description>

    <permission-map name="View" acquired="False">
      <permission-role>LabManager</permission-role>
      <permission-role>InventoryAdministrator</permission-role>
      <permission-role>Manager</permission-role>
      <!-- 中文注释：Owner = 创建者（CMF 自动赋予）。这样申请人能看到"自己那张"
           申请单，但看不到审批目录、也看不到别人的申请单。 -->
      <permission-role>Owner</permission-role>
    </permission-map>
    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Modify portal content" acquired="False"/>
    <permission-map name="Delete objects" acquired="False"/>
  </state>

  <!-- *** TRANSITIONS *** -->
  <!-- 守卫规则在 maitux.stock.guards 里实现（非申请人 / 审批角色 / 明细校验） -->

  <transition transition_id="submit" title="Submit for Review" new_state="submitted"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Submit</action>
    <guard>
      <guard-permission>Modify portal content</guard-permission>
      <guard-expression>python:here.guard_handler("submit")</guard-expression>
    </guard>
  </transition>

  <transition transition_id="approve" title="Approve" new_state="approved"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Approve</action>
    <guard>
      <guard-permission>Modify portal content</guard-permission>
      <guard-expression>python:here.guard_handler("approve")</guard-expression>
    </guard>
  </transition>

  <transition transition_id="reject" title="Reject" new_state="rejected"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Reject</action>
    <guard>
      <guard-permission>Modify portal content</guard-permission>
      <guard-expression>python:here.guard_handler("reject")</guard-expression>
    </guard>
  </transition>

  <transition transition_id="retract" title="Withdraw" new_state="cancelled"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Withdraw</action>
    <guard>
      <guard-permission>View</guard-permission>
      <guard-expression>python:here.guard_handler("retract")</guard-expression>
    </guard>
  </transition>

  <transition transition_id="cancel" title="Cancel" new_state="cancelled"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Cancel</action>
    <guard>
      <guard-permission>Modify portal content</guard-permission>
      <guard-expression>python:here.guard_handler("cancel")</guard-expression>
    </guard>
  </transition>

  <!-- *** VARIABLES *** -->

  <variable variable_id="action" for_catalog="False" for_status="True" update_always="True">
    <description>Previous transition</description>
    <default>
      <expression>transition/getId|nothing</expression>
    </default>
    <guard/>
  </variable>

  <variable variable_id="actor" for_catalog="False" for_status="True" update_always="True">
    <description>The ID of the user who performed the last transition</description>
    <default>
      <expression>user/getId</expression>
    </default>
    <guard/>
  </variable>

  <variable variable_id="comments" for_catalog="False" for_status="True" update_always="True">
    <description>Comment about the last transition</description>
    <default>
      <expression>python:state_change.kwargs.get('comment', '')</expression>
    </default>
    <guard/>
  </variable>

  <variable variable_id="review_history" for_catalog="False" for_status="False" update_always="False">
    <description>Provides access to workflow history</description>
    <default>
      <expression>state_change/getHistory</expression>
    </default>
    <guard/>
  </variable>

  <variable variable_id="time" for_catalog="False" for_status="True" update_always="True">
    <description>When the previous transition was performed</description>
    <default>
      <expression>state_change/getDateTime</expression>
    </default>
    <guard/>
  </variable>

</dc-workflow>
