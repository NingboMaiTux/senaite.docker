# ---------------------------------------------------------------------------
msgid "Analysis category"
msgstr "分析类别"

msgid "Analysis Keyword"
msgstr "检测项目关键词"

msgid "Analysis Service"
msgstr "检测项目"

msgid "calc keyword"
msgstr "公式字段关键词"

msgid "zh"
msgstr "中文名"

msgid "en"
msgstr "英文名"

