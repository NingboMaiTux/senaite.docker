<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:five="http://namespaces.zope.org/five"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="maitux.glossary">

  <i18n:registerTranslations directory="locales" />

  <include package="Products.Five" />
  <include package="Products.GenericSetup" file="meta.zcml" />
  <include package="Products.CMFCore" file="permissions.zcml" />

  <five:registerPackage package="." />

  <include package=".content" />
  <include package=".datamanagers" />
  <include package=".browser" />

  <genericsetup:registerProfile
      name="default"
      title="Maitux Keyword Glossary"
      directory="profiles/default"
      description="Inspection item keyword zh/en middle table"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Maitux Keyword Glossary (uninstall)"
      directory="profiles/uninstall"
      description="Uninstalls maitux.glossary"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.uninstall"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      provides="Products.CMFPlone.interfaces.INonInstallable"
      name="maitux.glossary-hiddenprofiles"
      />

  <utility
      factory=".vocabularies.SyncStatesVocabulary"
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="maitux.glossary.vocabularies.SyncStates"
      />

</configure>
