<?xml version="1.0" encoding="UTF-8"?>
<object name="GlossaryEntries" meta_type="Dexterity FTI"
        i18n:domain="maitux.glossary"
        xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        purge="True">

  <property name="title" i18n:translate="">Keyword glossary</property>
  <property name="description" i18n:translate="">Inspection item keyword glossary (middle table)</property>

  <property name="icon_expr">senaite_theme/icon/folder</property>
  <property name="factory">GlossaryEntries</property>
  <property name="add_view_expr">string:${folder_url}/++add++GlossaryEntries</property>
  <property name="immediate_view">glossary-listing</property>

  <property name="global_allow">False</property>
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types">
    <element value="GlossaryEntry" />
  </property>

  <property name="allow_discussion">False</property>
  <property name="default_view">glossary-listing</property>
  <property name="view_methods">
    <element value="glossary-listing"/>
    <element value="view"/>
  </property>
  <property name="default_view_fallback">False</property>

  <property name="add_permission">cmf.AddPortalContent</property>

  <property name="schema">maitux.glossary.interfaces.IGlossaryEntriesSchema</property>
  <property name="klass">maitux.glossary.content.glossaryentries.GlossaryEntries</property>

  <property name="behaviors">
    <element value="plone.app.dexterity.behaviors.metadata.IBasic"/>
    <element value="plone.app.referenceablebehavior.referenceable.IReferenceable" />
  </property>

  <alias from="(Default)" to="(dynamic view)"/>
  <alias from="edit" to="@@edit"/>
  <alias from="sharing" to="@@sharing"/>
  <alias from="view" to="(selected layout)"/>

</object>
