<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="maitux.auditjournal">

  <!--
    ★ 权限必须卡在这里。本视图直接读 SQL，绕过了对象级权限过滤
      （实施方案 §7.1 实测：同一 catalog searchResults 返回 66、
       unrestrictedSearchResults 返回 0，差异全来自权限）。
    ★ 用的是本包自定义权限，不是 senaite.core 的 —— 所以不需要 R1 的
      <include package="senaite.core.permissions" />（lint E05 会盯着）。
  -->
  <browser:page
      name="audit-journal"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".view.AuditJournalView"
      permission="maitux.auditjournal.ViewAuditJournal"
      layer="zope.publisher.interfaces.browser.IDefaultBrowserLayer"
      />

  <!--
    S5 回填入口。★ 权限与"看"分开：回填是写操作，只给 Manager。
    ★ 缺省 dry_run —— 真写库要显式 ?dry_run=0，免得手滑访问就写库。
  -->
  <browser:page
      name="audit-journal-backfill"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".backfill_view.BackfillView"
      permission="maitux.auditjournal.BackfillAuditJournal"
      layer="zope.publisher.interfaces.browser.IDefaultBrowserLayer"
      />

  <!--
    S6 兜底补录。★ 权限**复用**回填那个，不另立新权限 ——
    补录和回填是同一类动作（往审计表写历史行），拆开只会多一次 profile 升级。
    ★ 同样默认 dry_run。
  -->
  <browser:page
      name="audit-journal-replay"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".replay_view.ReplayView"
      permission="maitux.auditjournal.BackfillAuditJournal"
      layer="zope.publisher.interfaces.browser.IDefaultBrowserLayer"
      />

</configure>
