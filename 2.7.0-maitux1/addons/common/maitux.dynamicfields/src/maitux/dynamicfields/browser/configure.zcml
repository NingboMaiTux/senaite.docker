<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="maitux.dynamicfields">

  <!--
    R1 的同一套路：ZCML 里用到的权限必须先把定义它的包 include 进来，
    把注册顺序钉死。本包靠 z3c.autoinclude 加载，不保证排在 CMFCore 之后，
    少了这一行会在某些加载顺序下报
        ValueError: ('Undefined permission ID', 'cmf.ManagePortal')
    ——而且是启动期报错，站点直接起不来。实测（tools 里的 ZCML 加载检查）
    就是先踩到这条才补上的。
  -->
  <include package="Products.CMFCore" file="permissions.zcml" />

  <!--
    权限一律用 Plone 原生的 cmf.ManagePortal。

    刻意不碰 senaite.core 的自定义权限：本包靠 z3c.autoinclude 加载，顺序不保证
    排在 senaite.core 之后，引用它的权限就会撞上 R1 那颗雷
    （ComponentLookupError: (IPermission, 'senaite.core.permissions...')）。
    用原生权限从根上绕开。
  -->

  <browser:page
      name="dynamic-fields"
      for="*"
      class=".view.DynamicFieldsView"
      permission="cmf.ManagePortal"
      />

  <browser:page
      name="dynamic-fields-export"
      for="*"
      class=".view.DynamicFieldsExportView"
      permission="cmf.ManagePortal"
      />

  <!--
    Setup 页入口。SENAITE 的 setupview 是按容器里的内容对象渲染磁贴的，
    既不读 portal_actions，模板里也没有 viewlet manager 挂点；而本包不能建
    内容对象（写数据库）、不能写 actions.xml（要 profile）、也不能覆盖
    setupview（要 overrides + 浏览器层）。所以挂到 Plone 原生的
    plone.abovecontent 上，由 viewlet 自己判断上下文是不是 Setup 页。
  -->
  <browser:viewlet
      name="maitux.dynamicfields.setupentry"
      manager="plone.app.layout.viewlets.interfaces.IAboveContent"
      class=".viewlet.SetupEntryViewlet"
      permission="cmf.ManagePortal"
      />

  <!--
    「列表列」：列表视图的列来自视图类里写死的 self.columns，跟 schema
    无关，所以造字段那条路管不到，只能用官方的 IListingViewAdapter 扩展点
    往里插。

    for 的第二项是 Interface（所有上下文）—— 本包是平台级的，事先不知道
    用户会给哪个类型加字段，没法按对象接口逐个注册。门控在 before_render()
    里按 contentFilter["portal_type"] 做：没配置列的类型第一个 if 就返回。

    R14 / E17 要求往外来视图注入 UI 必须判 browser layer。本包没有 layer
    也不需要：它随镜像发布，不存在「没装本包的站点」，E17 防的泄漏在这儿
    不成立。
  -->
  <subscriber
      for="senaite.app.listing.interfaces.IListingView
           zope.interface.Interface"
      factory=".listing.DynamicFieldsListingAdapter"
      provides="senaite.app.listing.interfaces.IListingViewAdapter"
      />

</configure>
