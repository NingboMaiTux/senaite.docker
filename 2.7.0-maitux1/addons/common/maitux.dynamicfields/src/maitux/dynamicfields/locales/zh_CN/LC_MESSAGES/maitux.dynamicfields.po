msgstr "导入配置（JSON）"

msgid "Merge (add and overwrite)"
msgstr "合并（新增并覆盖同名）"

msgid "Replace (wipe first)"
msgstr "覆盖（先清空再导入）"

msgid "configuration record(s) skipped"
msgstr "条配置已被跳过"

msgid "Options (Choice type only)"
msgstr "选项列表（仅固定选项类型）"

msgid "Reference / numbers / constraints"
msgstr "对象引用 / 数值 / 数据约束"

msgid "Search objects"
msgstr "搜索对象"

msgid "Filter fields"
msgstr "筛选字段"

msgid "Go"
msgstr "搜索"

msgid "Clear"
msgstr "清除"

msgid "No object matches this keyword."
msgstr "没有匹配该关键字的对象。"

msgid "action_failed"
msgstr "操作失败：${error}"

msgid "broken_dropped"
msgstr "已删除失效配置 ${type}.${name}"

msgid "broken_reason"
msgstr "对象类型 ${type} 在当前站点不存在"

msgid "column_created"
msgstr "${catalog}：已创建 metadata 列 ${name}"

msgid "column_removed"
msgstr "${catalog}：已移除 metadata 列 ${name}"

msgid "delete_confirm"
msgstr "删除后该字段不再显示；对象上已写入的值会保留。确定删除？"

msgid "delete_missing"
msgstr "要删除的字段不存在"

msgid "deprecated_detail"
msgstr "${type} 已被 ${new} 取代（AT→DX 迁移遗留），两个类型在站点上都还注册着。给它加的字段不会出现在实际使用的那个类型上。"

msgid "field_deleted"
msgstr "字段 ${name} 已删除。对象上已写入的值保留但不再显示。"

msgid "field_missing"
msgstr "字段不存在"

msgid "field_saved"
msgstr "字段 ${name} 已保存，立即生效（无需重启容器）"

msgid "idx_yes"
msgstr "已建"

msgid "import_bad_structure"
msgstr "JSON 结构不对：缺少 fields 列表"

msgid "import_done"
msgstr "导入完成：新增 ${added} 条，覆盖 ${updated} 条，跳过 ${skipped} 条"

msgid "import_empty"
msgstr "没有可导入的内容"

msgid "import_no_portal"
msgstr "取不到 portal，无法导入"

msgid "import_parse_failed"
msgstr "JSON 解析失败：${error}"

msgid "index_created"
msgstr "${catalog}：已创建索引 ${name}"

msgid "index_rebuild_failed"
msgstr "${catalog}：索引 ${name} 重建失败，详见日志"

msgid "index_rebuilt"
msgstr "${catalog}：索引 ${name} 已重建"

msgid "index_removed"
msgstr "${catalog}：已移除索引 ${name}"

msgid "mech_at"
msgstr "Archetypes · 经 schemaextender 扩展"

msgid "mech_dx"
msgstr "Dexterity · 经 behavior 扩展"

msgid "record_missing"
msgstr "该配置不存在"

msgid "shadow_warning"
msgstr "${type} 上有别的 add-on 注册了更具体的 IBehaviorAssignable，本包的动态字段在该类型上不会生效。"

msgid "v_bad_field_type"
msgstr "字段类型不合法：${type}"

msgid "v_bad_name"
msgstr "字段名只能是 ASCII 字母开头、由字母/数字/下划线组成，长度 2-50：${name}"

msgid "v_bad_regex"
msgstr "校验正则不合法：${error}"

msgid "v_dup_foreign"
msgstr "${type} 上已经存在同名字段（原生或其它 add-on 提供），换一个名字"

msgid "v_dup_own"
msgstr "该对象上已经有一个叫 ${name} 的自定义字段"

msgid "v_min_max"
msgstr "最小值不能大于最大值"

msgid "v_min_max_num"
msgstr "最小值 / 最大值必须是数字"

msgid "v_need_label"
msgstr "至少要填一种语言的标签"

msgid "v_need_name"
msgstr "必须填字段名"

msgid "v_need_option"
msgstr "固定选项类型必须至少配一个选项"

msgid "v_need_type"
msgstr "必须指定目标对象"

msgid "v_needs_metadata"
msgstr "要在列表页显示，必须同时勾选「创建 metadata 列」——没有它列表页取不到值"

msgid "v_option_ascii"
msgstr "选项存储值必须是 ASCII（字母数字、下划线、连字符）：${key} —— 中文只能填在标签里"

msgid "v_option_dup"
msgstr "选项存储值重复：${key}"

msgid "v_option_key_empty"
msgstr "选项的存储值不能为空"

msgid "v_option_label"
msgstr "选项 ${key} 至少要填一种语言的标签"

msgid "v_quota_total"
msgstr "全站最多 ${max} 个自定义字段，已达上限"

msgid "v_quota_type"
msgstr "单个对象最多 ${max} 个自定义字段，已达上限"

msgid "v_ref_types"
msgstr "对象引用类型必须指定允许的对象类型"

msgid "v_regex_msg"
msgstr "填了校验正则就必须填校验失败提示"

msgid "v_reserved"
msgstr "${name} 是保留名，不能用作字段名"

msgid "v_type_excluded"
msgstr "对象类型 ${type} 已被明确排除，不能加字段"

msgid "v_type_unsupported"
msgstr "对象类型 ${type} 不在支持清单内"

msgid "Business name or portal_type"
msgstr "业务名 或 portal_type"

msgid "Field name or label"
msgstr "字段名 / 标签"

msgid "The stored value must be an ASCII key; localized text belongs in the labels. Once localized text is stored on the objects it can never be translated, and indexes, exports and statistics are locked to that one language. Changing it later means migrating data."
msgstr "存储值必须是 ASCII key，本地化文案只能填在标签里。一旦把本地化文案存进对象，这份数据就永远翻译不了，索引、导出、统计也全部锁死在那一种语言上——事后再改需要迁数据。"

msgid "These switches apply to the standard edit and view forms, to the sample add form (it does read the AR schema) and to the header table. They do NOT reach the listing views, whose columns come from a dict unrelated to the schema, nor the worksheet results entry header, which is a hand written template."
msgstr "这些开关对标准编辑页、查看页、样品新建页（它确实读 AR schema）和 header_table 都生效。但列表页（列来自与 schema 无关的字典）和工作表结果录入页页头（手写模板）覆盖不到。"

msgid "This object type is deprecated."
msgstr "该对象类型已废弃。"

msgid "deprecated"
msgstr "已废弃"

msgid "or a new group name"
msgstr "或填一个新分组名"

msgid "Groups the field into a tab on the edit form. Pick an existing group, or type a new name to create one."
msgstr "把字段归进编辑页上的一个分组标签页。可以选已有的分组，也可以填一个新名字新建一个。"

msgid "This object type does not render fieldsets: its schema uses no groups at all and the sample add form ignores them. Anything set here would have no visible effect."
msgstr "该对象类型不渲染分组：它的 schema 里一个分组都没用，样品新建页也完全不读分组。这里填什么都不会有可见效果。"

msgid "Puts the field into one of the tabs on the edit form. Only groups this object type already has are offered."
msgstr "把字段放进编辑页上的某个标签页。只列该对象类型已有的分组。"

msgid "fs_skip_dx"
msgstr "不显示分组：SENAITE 的 Dexterity 编辑页不渲染分组。"

msgid "fs_skip_excluded"
msgstr "不显示分组：该类型自身一个分组都没用，它的新建页也不读分组。"

msgid "fs_skip_single"
msgstr "不显示分组：该类型只有 default 一个分组。"

msgid "Leave it at 0 unless you need a specific order. 0 means the fields appear in the order they were created."
msgstr "没有特殊需求就保持 0。填 0 表示按创建先后顺序显示，不用管它。"

msgid "Options"
msgstr "选项列表"

msgid "Reference target"
msgstr "引用目标"

msgid "Allowed object types"
msgstr "允许的对象类型"

msgid "Include inactive objects"
msgstr "包含已停用的对象"

msgid "Traceability fields usually need this: the object that was used back then may have been deactivated since."
msgstr "追溯类字段通常要勾上：当时用的那个对象，事后可能已经被停用了。"

msgid "Number range"
msgstr "数值范围"

msgid "Text constraints"
msgstr "文本约束"

msgid "Validation regex"
msgstr "校验正则"

msgid "Message on failure"
msgstr "校验失败提示"

msgid "If you fill in a regex you must also fill in a failure message."
msgstr "填了校验正则，就必须填校验失败提示。"

msgid "Data constraints"
msgstr "数据约束"

msgid "Default value"
msgstr "默认值"

msgid "Choice: one of the ASCII keys above. Boolean: 1 / true / yes means checked. Date fields take no default."
msgstr "固定选项：填上面某个 ASCII key。布尔：1 / true / yes 表示勾上。日期类型不支持默认值。"

msgid "Multi valued"
msgstr "多值"

msgid "ASCII lower case, digits and underscore. Cannot be changed later."
msgstr "ASCII 字母开头，只能用字母、数字、下划线。创建后不能改。"

msgid "As a listing column (requires the metadata column below)"
msgstr "在列表页作为一列显示（需要同时勾下面的 metadata 列）"

msgid "Cannot be changed later; delete and re-create instead."
msgstr "创建后不能改。要换类型只能删掉重建。"

msgid "Configuration does not travel with GenericSetup, so this is the only way to move it between sites."
msgstr "配置不会跟着 GenericSetup 走，站点之间搬运只能用这个。"

msgid "Editable in workflow states (empty = any)"
msgstr "哪些状态下可以改这个字段"

msgid "In which states can this field be edited"
msgstr "哪些状态下可以改这个字段"

msgid "Select nothing and the field can be edited in any state. That is what you want most of the time. Only pick states if the field must be frozen after a certain point."
msgstr "什么都不选 = 任何状态下都能改，多数情况就该这样。只有当这个字段过了某个环节就不许再动时，才需要选。"

msgid "Existing objects are only covered after pressing Reindex. Turn indexes off again before rolling the add-on back."
msgstr "已有的旧数据要点「重建索引」才会补上。回滚本 add-on 之前记得先把索引关掉。"

msgid "Labels (stored as data, applied without a restart)"
msgstr "标签（存在配置库里，改完不用重启）"

msgid "No custom fields on this object yet."
msgstr "这个对象还没有自定义字段。"

msgid "Startup skipped them and logged an error; the site itself is unaffected."
msgstr "启动时已跳过并记了错误日志，站点本身不受影响。"

msgid "Takes effect immediately; no container restart needed."
msgstr "保存后立即生效，不用重启容器。"

msgid "Pre-filled when a new object is created. Leave it empty if there is no sensible default."
msgstr "新建对象时自动填好的内容。没有合适的默认值就留空。"

msgid "The number pre-filled when a new object is created. Leave it empty if there is no sensible default."
msgstr "新建对象时自动填好的数字。没有合适的默认值就留空。"

msgid "Type 1 to have the box ticked by default. Leave it empty and the box starts unticked."
msgstr "填 1 表示默认打勾。留空就是默认不打勾。"

msgid "Which option is picked by default. Type one of the storage keys from the Options list above, not the label."
msgstr "默认选中哪一项。填上面选项列表里「存储值 key」那一列的内容，不是标签。"

msgid "Careful with existing data: once required, old objects have to fill it in the next time someone edits them."
msgstr "对已有数据要当心：设成必填后，旧对象下次被编辑时会被要求补填这一项。"

msgid "Shown but not editable in the interface; only an interface or a script can write it."
msgstr "界面上只显示、不让改，只有接口或脚本能写。"

msgid "Upload the file exported from another site"
msgstr "上传从别的站点导出的文件"

msgid "taken from the selection on the left; cannot be changed"
msgstr "由左侧选中的对象带入，不能改"

msgid "…or paste the JSON here"
msgstr "…或者把 JSON 直接粘在这里"

msgid "How this field gets filled in"
msgstr "这个字段怎么填"

msgid "All of this is optional. Leave everything alone and the field behaves the most permissive way: anyone may leave it blank and may change it at any time. Only touch it if you need something stricter."
msgstr "这一整块都可以不管。什么都不动的话，这个字段最宽松：可以不填，任何时候都能改。只有你需要更严的规矩时才来动它。"

msgid "What may be typed in"
msgstr "能填什么内容"

msgid "Pre-fill it with"
msgstr "新建时先帮我填上"

msgid "It must be filled in before saving"
msgstr "不填就不让保存"

msgid "Careful with data you already have: once this is on, old records have to fill it in the next time anyone edits them."
msgstr "对已有数据要当心：勾上之后，旧记录下次被人编辑时会被要求补填这一项。"

msgid "Show it, but nobody may type in it"
msgstr "只给人看，不让人填"

msgid "For values that come from somewhere else - an import, an instrument, a script. People see it but cannot change it."
msgstr "适合那些值来自别处的字段——导入的、仪器传来的、脚本写的。人能看到但改不了。"

msgid "It may only be changed in these stages"
msgstr "只有在这些阶段才允许改"

msgid "Select nothing and it can be changed at any time - that is the normal case. Only pick stages when the value has to be frozen once the sample moves on, so that nobody edits it after the fact."
msgstr "什么都不选 = 任何时候都能改，这是常态。只有当这个值在样品流转到下一步之后就该定死、不许事后再改时，才去选阶段。"

msgid "This object type has no workflow stages."
msgstr "这个对象类型没有工作流阶段。"

msgid "Which kind of object this field points at. Hold Ctrl (Cmd on a Mac) to pick more than one."
msgstr "这个字段指向哪一类对象。按住 Ctrl（Mac 上是 Cmd）可以多选。"
